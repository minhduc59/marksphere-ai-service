# Database
DATABASE_URL=postgresql+asyncpg://scanner:scanner_pass@localhost:5432/trending_scanner

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-xxx

# RapidAPI (TikTok, Twitter, Instagram)
RAPIDAPI_KEY=

# Firecrawl
FIRECRAWL_API_KEY=

# Modal (GPU inference)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=
MODAL_FUNCTION_NAME=
MODAL_CHECKPOINT=

# Cloudinary (temporary image hosting; will be replaced by S3)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=


# Modal (FLUX.2-klein fine-tuned image generation)
# Get token from: modal token new  OR  Modal dashboard → Settings → API Tokens
# App must be deployed first: cd Fine-tuned-Flux2-4B && modal deploy modal_eval_app.py
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_APP_NAME=flux-eval
MODAL_FUNCTION_NAME=generate_finetuned
MODAL_CHECKPOINT=checkpoint-2250

# App
APP_ENV=development
LOG_LEVEL=INFO

# NestJS backend gateway (added for multi-user support)
# Local dev: http://localhost:3000
# Docker Compose: http://backend:3000  ← use the service name, not localhost
# IMPORTANT: "[Errno -2] Name or service not known" means this value is wrong for your env
BACKEND_ORIGIN=http://localhost:3000
INTERNAL_API_KEY=
REQUIRE_INTERNAL_AUTH=false
